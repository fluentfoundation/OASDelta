<?xml version="1.0" encoding="utf-8"?>
<!-- Coverlet collector settings, used by CI as: dotnet test, collect "XPlat Code Coverage", settings this file.
     Generated tables (*.g.cs, produced from upstream Go by tools/) are excluded so the numbers reflect hand-written code. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[oasdelta]*</Include>
          <ExcludeByFile>**/*.g.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
