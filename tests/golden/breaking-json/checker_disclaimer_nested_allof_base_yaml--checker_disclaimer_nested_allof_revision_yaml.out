[{"id":"response-property-became-optional","text":"the response property `p/allOf[#/components/schemas/A]/id` became optional for the status `200`","comment":"This compared the `allOf` branches one at a time, so another branch may already describe what changed here, leaving the merged schema the same. Run with --flatten-allof to merge the branches and compare what they describe together.","disclaimers":["all-of-not-flattened"],"level":2,"operation":"GET","path":"/x","section":"paths","baseSource":{"file":"./checker/disclaimer_nested_allof_base.yaml","line":20,"column":34},"fingerprint":"7179ddcb1f95"}]
