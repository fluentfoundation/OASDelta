[{"id":"api-security-component-openid-connect-url-changed","text":"the component security scheme `openid` OpenID Connect url changed from `https://auth.example.com/.well-known/openid-configuration` to `https://id0.example.com/.well-known/openid-configuration`","comment":"This is a warning because the spec does not say whether credentials obtained through the previous URL are still accepted.","level":2,"section":"components","baseSource":{"file":"./properties/rules/response-property-multiple-of-specialized_base.yaml","line":11,"column":9,"endLine":13,"endColumn":32},"revisionSource":{"file":"./properties/rules/response-property-multiple-of-specialized_revision.yaml","line":11,"column":9,"endLine":13,"endColumn":32},"fingerprint":"3f76f0e2e10b"}]
