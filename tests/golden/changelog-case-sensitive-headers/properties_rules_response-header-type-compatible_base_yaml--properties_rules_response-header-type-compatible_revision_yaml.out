[{"id":"response-header-type-compatible","text":"the `0x1F` response header's `type` changed from `string` to `object` for the status `200` (backward compatible)","comment":"This change is backward compatible because a header value is transmitted as text, so any type can be represented as a string on the wire and is not enforced there.","level":1,"operation":"PATCH","operationId":"patch_ünïcode_ключ","path":"/ünïcode/ключ","section":"paths","baseSource":{"file":"./properties/rules/response-header-type-compatible_base.yaml","line":63,"column":25,"endLine":67,"endColumn":45},"revisionSource":{"file":"./properties/rules/response-header-type-compatible_revision.yaml","line":63,"column":25,"endLine":67,"endColumn":45},"fingerprint":"9fcf958a577a"}]
