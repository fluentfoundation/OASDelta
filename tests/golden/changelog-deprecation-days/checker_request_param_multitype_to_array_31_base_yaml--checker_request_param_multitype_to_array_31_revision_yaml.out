[{"id":"request-parameter-type-generalized","text":"for the `query` request parameter `token`, the `type` was widened from `string, integer` to `array\u003cstring\u003e`","comment":"This parameter uses form/explode serialization, where a single value is a valid one-element array, so widening it to an array whose items still accept the previous values does not break existing clients.","level":1,"operation":"POST","operationId":"createOneGroup","path":"/api/v1.0/groups","section":"paths","baseSource":{"file":"./checker/request_param_multitype_to_array_31_base.yaml","line":13,"column":13},"revisionSource":{"file":"./checker/request_param_multitype_to_array_31_revision.yaml","line":13,"column":13},"fingerprint":"9ed23d5be921"}]
