[{"id":"request-property-prefix-items-removed","text":"removed `subschema #1` from the `details` request property 'prefixItems' list","comment":"This is a warning because oasdiff cannot determine whether the change is breaking. An array position not covered by prefixItems is validated against the items schema: when items is absent the position accepts any value, and when items is false it allows no value, so this change may either reject arrays that were previously valid or allow arrays that previously were not.","level":2,"operation":"POST","operationId":"createProduct","path":"/products","section":"paths","baseSource":{"file":"./checker/prefix_items_prop_revision.yaml","line":19,"column":19},"fingerprint":"6548de0c8ef8"},{"id":"response-property-prefix-items-removed","text":"removed `subschema #1` from the `details` response property 'prefixItems' list for the response status `200`","comment":"This is a warning because oasdiff cannot determine whether the change is breaking. An array position not covered by prefixItems is validated against the items schema: when items is absent the position accepts any value, and when items is false it allows no value, so this change may either reject arrays that were previously valid or allow arrays that previously were not.","level":2,"operation":"POST","operationId":"createProduct","path":"/products","section":"paths","baseSource":{"file":"./checker/prefix_items_prop_revision.yaml","line":33,"column":21},"fingerprint":"c639000c6efd"}]
