<?xml version="1.0" encoding="UTF-8"?>
<testsuites>
  <testsuite package="com.oasdiff" time="0" tests="8" errors="0" failures="8" name="OASDiff">
    <testcase name="request-body-exclusive-max-increased" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the request's body exclusiveMaximum was increased from `50.00` to `100.00`</failure>
    </testcase>
    <testcase name="request-body-exclusive-min-decreased" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the request's body exclusiveMinimum was decreased from `5.00` to `0.00`</failure>
    </testcase>
    <testcase name="request-parameter-exclusive-max-increased" classname="OASDiff" time="0">
      <failure message="Breaking change detected">for the `query` request parameter `limit`, the exclusiveMaximum was increased from `50.00` to `100.00`</failure>
    </testcase>
    <testcase name="request-parameter-exclusive-min-decreased" classname="OASDiff" time="0">
      <failure message="Breaking change detected">for the `query` request parameter `limit`, the exclusiveMinimum was decreased from `5.00` to `0.00`</failure>
    </testcase>
    <testcase name="request-property-exclusive-max-increased" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the `price` request property's exclusiveMaximum was increased from `500.00` to `1000.00`</failure>
    </testcase>
    <testcase name="request-property-exclusive-min-decreased" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the `price` request property's exclusiveMinimum was decreased from `10.00` to `0.00`</failure>
    </testcase>
    <testcase name="response-body-exclusive-max-decreased" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the response's body exclusiveMaximum was decreased from `200.00` to `100.00`</failure>
    </testcase>
    <testcase name="response-property-exclusive-max-decreased" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the `price` response property's exclusiveMaximum was decreased from `2000.00` to `1000.00` for the response status `200`</failure>
    </testcase>
  </testsuite>
</testsuites>
