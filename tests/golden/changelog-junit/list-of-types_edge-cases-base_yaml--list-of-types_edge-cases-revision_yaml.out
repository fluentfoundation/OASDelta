<?xml version="1.0" encoding="UTF-8"?>
<testsuites>
  <testsuite package="com.oasdiff" time="0" tests="5" errors="0" failures="5" name="OASDiff">
    <testcase name="response-property-list-of-types-widened" classname="OASDiff" time="0">
      <failure message="Breaking change detected">response property `mixedBoth` list-of-types was widened by adding types `number` to media type `application/json` of response `200`</failure>
    </testcase>
    <testcase name="response-property-one-of-added" classname="OASDiff" time="0">
      <failure message="Breaking change detected">added `subschema #1, subschema #2` to the `complexOneOf` response property `oneOf` list for the response status `200`</failure>
    </testcase>
    <testcase name="api-version-not-bumped" classname="OASDiff" time="0">
      <failure message="Breaking change detected">a breaking change was detected but the version is still `1.0.0`</failure>
    </testcase>
    <testcase name="response-property-one-of-removed" classname="OASDiff" time="0">
      <failure message="Breaking change detected">removed `subschema #1, subschema #2` from the `complexOneOf` response property `oneOf` list for the response status `200`</failure>
    </testcase>
    <testcase name="response-property-type-specialized" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the `emptyOneOf` response's property `type` was narrowed from `any` to `string` for status `200`</failure>
    </testcase>
  </testsuite>
</testsuites>
