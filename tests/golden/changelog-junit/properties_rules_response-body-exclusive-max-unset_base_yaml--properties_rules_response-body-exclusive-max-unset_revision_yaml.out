<?xml version="1.0" encoding="UTF-8"?>
<testsuites>
  <testsuite package="com.oasdiff" time="0" tests="11" errors="0" failures="11" name="OASDiff">
    <testcase name="response-body-exclusive-max-unset" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the response's body exclusiveMaximum was unset from `1017.00`</failure>
    </testcase>
    <testcase name="response-body-min-unset" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the response's body min was unset from `-5.00`</failure>
    </testcase>
    <testcase name="response-body-multiple-of-unset" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the response's body multipleOf was unset from `5.00`</failure>
    </testcase>
    <testcase name="response-body-type-changed" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the response's body `type` changed from `integer, null` to `string` for status `204`</failure>
    </testcase>
    <testcase name="response-mediatype-became-not-enum" classname="OASDiff" time="0">
      <failure message="Breaking change detected">removed the enum constraint from the response schema `multipart/form-data` for the response status `204`</failure>
    </testcase>
    <testcase name="request-body-media-type-removed" classname="OASDiff" time="0">
      <failure message="Breaking change detected">removed the media type `application/json; charset=utf-8` from the request body</failure>
    </testcase>
    <testcase name="request-body-media-type-removed" classname="OASDiff" time="0">
      <failure message="Breaking change detected">removed the media type `text/plain` from the request body</failure>
    </testcase>
    <testcase name="api-version-not-bumped" classname="OASDiff" time="0">
      <failure message="Breaking change detected">a breaking change was detected but the version is still `1.0.0`</failure>
    </testcase>
    <testcase name="response-body-became-not-nullable" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the response's body became not nullable</failure>
    </testcase>
    <testcase name="response-body-default-value-removed" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the response body `multipart/form-data` default value `0.00` was removed for the status `204`</failure>
    </testcase>
    <testcase name="request-body-media-type-added" classname="OASDiff" time="0">
      <failure message="Breaking change detected">added the media type `*/*` to the request body</failure>
    </testcase>
  </testsuite>
</testsuites>
