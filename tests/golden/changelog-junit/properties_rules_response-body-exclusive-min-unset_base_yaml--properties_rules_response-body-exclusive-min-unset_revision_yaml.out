<?xml version="1.0" encoding="UTF-8"?>
<testsuites>
  <testsuite package="com.oasdiff" time="0" tests="4" errors="0" failures="4" name="OASDiff">
    <testcase name="response-body-exclusive-min-unset" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the response's body exclusiveMinimum was unset from `-2.00`</failure>
