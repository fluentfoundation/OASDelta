<?xml version="1.0" encoding="UTF-8"?>
<testsuites>
  <testsuite package="com.oasdiff" time="0" tests="4" errors="0" failures="4" name="OASDiff">
    <testcase name="response-header-min-decreased" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the `>` response header's min was decreased from `4.00` to `2.00` for the status `200`</failure>
    </testcase>
    <testcase name="request-parameter-removed" classname="OASDiff" time="0">
      <failure message="Breaking change detected">deleted the `header` request parameter `owner`</failure>
    </testcase>
    <testcase name="api-version-not-bumped" classname="OASDiff" time="0">
      <failure message="Breaking change detected">a breaking change was detected but the version is still `1.0.0`</failure>
    </testcase>
    <testcase name="response-property-type-specialized" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the `_under_/items/` response's property `format` was narrowed from `none` to `byte` for status `201`</failure>
    </testcase>
  </testsuite>
</testsuites>
