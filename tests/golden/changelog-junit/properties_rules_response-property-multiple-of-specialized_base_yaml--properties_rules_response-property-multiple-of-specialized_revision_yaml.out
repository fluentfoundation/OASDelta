<?xml version="1.0" encoding="UTF-8"?>
<testsuites>
  <testsuite package="com.oasdiff" time="0" tests="4" errors="0" failures="4" name="OASDiff">
    <testcase name="api-security-component-openid-connect-url-changed" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the component security scheme `openid` OpenID Connect url changed from `https://auth.example.com/.well-known/openid-configuration` to `https://id0.example.com/.well-known/openid-configuration`</failure>
    </testcase>
    <testcase name="response-property-multiple-of-specialized" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the `oneOf[subschema #1]/anyOf[subschema #2]/` response property's multipleOf was specialized from `2.00` to `4.00` for the response status `500`</failure>
    </testcase>
    <testcase name="response-property-type-specialized" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the `oneOf[subschema #1]/` response's property `format` was narrowed from `none` to `float` for status `500`</failure>
    </testcase>
    <testcase name="optional-response-header-removed" classname="OASDiff" time="0">
      <failure message="Breaking change detected">the optional response header `퉈祅闄췱` removed for the status `500`</failure>
    </testcase>
  </testsuite>
</testsuites>
