[{"id":"request-body-max-items-set","text":"the request's body maxItems was set to `11`","comment":"Setting a bound rejects values the previous contract accepted. If your clients are known to stay within the new limit, lower this check with --severity-levels. This compared the `allOf` branches one at a time, so another branch may still guarantee what this one dropped. Run with --flatten-allof to merge the branches and compare what they describe together.","disclaimers":["all-of-not-flattened"],"level":2,"operation":"PUT","operationId":"owner","path":"/pets","section":"paths","revisionSource":{"file":"./properties/rules/request-body-max-items-set_revision.yaml","line":99,"column":29},"fingerprint":"2a03470ad370"}]
