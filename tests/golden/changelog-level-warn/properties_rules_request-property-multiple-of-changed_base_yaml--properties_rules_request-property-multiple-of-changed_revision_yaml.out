[{"id":"request-property-multiple-of-changed","text":"the `items` request property's multipleOf was changed from `5.00` to `2.00`","comment":"This compared the `allOf` branches one at a time, so another branch may already describe what changed here, leaving the merged schema the same. Run with --flatten-allof to merge the branches and compare what they describe together.","disclaimers":["all-of-not-flattened"],"level":2,"operation":"PUT","operationId":"put_owners_{ownerId}_pets","path":"/owners/{ownerId}/pets","section":"paths","baseSource":{"file":"./properties/rules/request-property-multiple-of-changed_base.yaml","line":263,"column":33},"revisionSource":{"file":"./properties/rules/request-property-multiple-of-changed_revision.yaml","line":267,"column":33},"fingerprint":"dae8dec409c2"}]
