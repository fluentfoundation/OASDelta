[{"id":"api-security-component-openid-connect-url-changed","text":"the component security scheme `openid` OpenID Connect url changed from `https://auth.example.com/.well-known/openid-configuration` to `https://id0.example.com/.well-known/openid-configuration`","comment":"This is a warning because the spec does not say whether credentials obtained through the previous URL are still accepted.","level":2,"section":"components","baseSource":{"file":"./properties/rules/response-property-multiple-of-specialized_base.yaml","line":11,"column":9,"endLine":13,"endColumn":32},"revisionSource":{"file":"./properties/rules/response-property-multiple-of-specialized_revision.yaml","line":11,"column":9,"endLine":13,"endColumn":32},"fingerprint":"3f76f0e2e10b"},{"id":"response-property-multiple-of-specialized","text":"the `oneOf[subschema #1]/anyOf[subschema #2]` response property's multipleOf was specialized from `2.00` to `4.00` for the response status `500`","comment":"This change is not breaking because the new multipleOf is an integer multiple of the old one, so every value the server may now produce was already valid before.","level":1,"operation":"DELETE","operationId":"delete_pets","path":"/pets","section":"paths","baseSource":{"file":"./properties/rules/response-property-multiple-of-specialized_base.yaml","line":67,"column":43},"revisionSource":{"file":"./properties/rules/response-property-multiple-of-specialized_revision.yaml","line":67,"column":43},"fingerprint":"06b3c8c96d0f"},{"id":"response-property-type-specialized","text":"the `oneOf[subschema #1]` response's property `format` was narrowed from `none` to `float` for status `500`","level":1,"operation":"DELETE","operationId":"delete_pets","path":"/pets","section":"paths","fingerprint":"5d325b2f16e5"}]
