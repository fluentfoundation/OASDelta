paths:
    modified:
        /api/v1.0/groups:
            operations:
                modified:
                    POST:
                        responses:
                            modified:
                                "200":
                                    content:
                                        modified:
                                            application/problem+json;q=1:
                                                name:
                                                    name:
                                                        from: application/json
                                                        to: application/problem+json;q=1
                                                    subtype:
                                                        from: json
                                                        to: problem
                                                    suffix:
                                                        from: ""
                                                        to: json
                                                    parameters:
                                                        added:
                                                            - q
endpoints:
    modified:
        ?   method: POST
            path: /api/v1.0/groups
        :   responses:
                modified:
                    "200":
                        content:
                            modified:
                                application/problem+json;q=1:
                                    name:
                                        name:
                                            from: application/json
                                            to: application/problem+json;q=1
                                        subtype:
                                            from: json
                                            to: problem
                                        suffix:
                                            from: ""
                                            to: json
                                        parameters:
                                            added:
                                                - q

