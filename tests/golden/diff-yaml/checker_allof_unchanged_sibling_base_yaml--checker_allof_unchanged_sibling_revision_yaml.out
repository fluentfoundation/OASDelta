paths:
    modified:
        /items:
            operations:
                modified:
                    POST:
                        requestBody:
                            content:
                                modified:
                                    application/json:
                                        schema:
                                            properties:
                                                modified:
                                                    wrapper:
                                                        maxLength:
                                                            from: 10
                                                            to: 5
endpoints:
    modified:
        ?   method: POST
            path: /items
        :   requestBody:
                content:
                    modified:
                        application/json:
                            schema:
                                properties:
                                    modified:
                                        wrapper:
                                            maxLength:
                                                from: 10
                                                to: 5

