paths:
    modified:
        /subscribe:
            operations:
                modified:
                    POST:
                        securityRequirements:
                            modified:
                                - base:
                                    index: 0
                                    schemes:
                                        petstore_auth:
                                            - write:pets
                                            - read:pets
                                  revision:
                                    index: 0
                                    schemes:
                                        petstore_auth:
                                            - write:pets
                                  scopes:
                                    petstore_auth:
                                        deleted:
                                            - read:pets
endpoints:
    modified:
        ?   method: POST
            path: /subscribe
        :   securityRequirements:
                modified:
                    - base:
                        index: 0
                        schemes:
                            petstore_auth:
                                - write:pets
                                - read:pets
                      revision:
                        index: 0
                        schemes:
                            petstore_auth:
                                - write:pets
                      scopes:
                        petstore_auth:
                            deleted:
                                - read:pets

