paths:
    modified:
        /products:
            operations:
                modified:
                    POST:
                        requestBody:
                            content:
                                deleted:
                                    - application/json
                                modified:
                                    text/plain:
                                        schema:
                                            const:
                                                from: FixedValue
                                                to: NewFixedValue
endpoints:
    modified:
        ?   method: POST
            path: /products
        :   requestBody:
                content:
                    deleted:
                        - application/json
                    modified:
                        text/plain:
                            schema:
                                const:
                                    from: FixedValue
                                    to: NewFixedValue

