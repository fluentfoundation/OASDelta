info:
    version:
        from: "1.0"
        to: "2.0"
paths:
    modified:
        /test:
            operations:
                modified:
                    POST:
                        parameters:
                            modified:
                                query:
                                    category:
                                        schema:
                                            maxLength:
                                                from: 10
                                                to: 15
endpoints:
    modified:
        ?   method: POST
            path: /test
        :   parameters:
                modified:
                    query:
                        category:
                            schema:
                                maxLength:
                                    from: 10
                                    to: 15

