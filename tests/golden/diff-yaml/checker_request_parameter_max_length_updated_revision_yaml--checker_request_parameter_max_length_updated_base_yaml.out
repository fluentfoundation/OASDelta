info:
    version:
        from: "2.0"
        to: "1.0"
paths:
    modified:
        /test:
            operations:
                modified:
                    POST:
                        parameters:
                            modified:
                                query:
                                    category:
                                        schema:
                                            maxLength:
                                                from: 15
                                                to: 10
endpoints:
    modified:
        ?   method: POST
            path: /test
        :   parameters:
                modified:
                    query:
                        category:
                            schema:
                                maxLength:
                                    from: 15
                                    to: 10

