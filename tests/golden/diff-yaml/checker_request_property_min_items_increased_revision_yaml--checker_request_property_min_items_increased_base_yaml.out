paths:
    modified:
        /products:
            operations:
                modified:
                    POST:
                        requestBody:
                            content:
                                modified:
                                    application/json:
                                        schema:
                                            minItems:
                                                from: 20
                                                to: 10
endpoints:
    modified:
        ?   method: POST
            path: /products
        :   requestBody:
                content:
                    modified:
                        application/json:
                            schema:
                                minItems:
                                    from: 20
                                    to: 10

