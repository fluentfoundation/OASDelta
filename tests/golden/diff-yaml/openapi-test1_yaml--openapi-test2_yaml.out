                        domain:
                            schema:
                                type:
                                    added:
                                        - integer
                                    deleted:
                                        - string
                                format:
                                    from: hyphen-separated list
                                    to: non-negative integer
                                description:
                                    from: Hyphen-separated list of lowercase string
                                    to: Non-negative integers (including zero)
                                example:
                                    from: generic-bank
                                    to: "100"
                                min:
                                    from: null
                                    to: 7
                                pattern:
                                    from: ^(?:([a-z]+-)*([a-z]+)?)$
                                    to: ^(?:\d+)$
                    query:
                        filter:
                            extensions:
                                deleted:
                                    - x-extension-test
                            content:
                                modified:
                                    application/json:
                                        extensions:
                                            deleted:
                                                - x-extension-test
                                        schema:
                                            properties:
                                                modified:
                                                    color:
                                                        type:
                                                            added:
                                                                - number
                                                            deleted:
                                                                - string
                        image:
                            explode:
                                from: null
                                to: true
                            schema:
                                extensions:
                                    deleted:
                                        - x-extension-test
                                description:
                                    from: alphanumeric
                                    to: alphanumeric with underscore, dash, period, slash and colon
                            examples:
                                deleted:
                                    - "0"
                        token:
                            schema:
                                anyOf:
                                    added:
                                        - index: 0
                                        - index: 1
                                type:
                                    deleted:
                                        - string
                                format:
                                    from: uuid
                                    to: ""
                                description:
                                    from: RFC 4122 UUID
                                    to: ""
                                example:
                                    from: 26734565-dbcc-449a-a370-0beaaf04b0e8
                                    to: null
                                maxLength:
                                    from: 29
                                    to: null
                                pattern:
                                    from: ^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12})$
