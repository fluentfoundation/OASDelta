paths:
    modified:
        /store/order:
            operations:
                modified:
                    POST:
                        extensions:
                            added:
                                - x-stability-level
                        requestBody:
                            content:
                                modified:
                                    application/json:
                                        schema:
                                            items:
                                                maxItems:
                                                    from: 50
                                                    to: 53
