paths:
    modified:
        /items/{id}.json:
            summary:
                from: ""
                to: price
            operations:
                modified:
                    PATCH:
                        responses:
                            modified:
                                "404":
                                    content:
                                        modified:
                                            text/plain:
                                                schema:
                                                    properties:
                                                        modified:
                                                            "\a":
                                                                readOnly:
                                                                    from: false
                                                                    to: true
        /owners/{ownerId}/pets:
            operations:
                modified:
                    PUT:
                        requestBody:
                            content:
                                modified:
                                    '*/*':
                                        schema:
                                            items:
                                                allOf:
                                                    added:
                                                        - index: 0
                                                multipleOf:
                                                    from: 5
                                                    to: 2
endpoints:
    modified:
        ?   method: PATCH
            path: /items/{id}.json
        :   responses:
                modified:
                    "404":
                        content:
                            modified:
                                text/plain:
                                    schema:
                                        properties:
                                            modified:
                                                "\a":
                                                    readOnly:
                                                        from: false
                                                        to: true
        ?   method: PUT
            path: /owners/{ownerId}/pets
        :   requestBody:
                content:
                    modified:
                        '*/*':
                            schema:
                                items:
                                    allOf:
                                        added:
                                            - index: 0
                                    multipleOf:
                                        from: 5
                                        to: 2

