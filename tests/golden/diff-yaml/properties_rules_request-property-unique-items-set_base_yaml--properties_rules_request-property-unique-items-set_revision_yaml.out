paths:
    modified:
        /pets:
            operations:
                deleted:
                    - DELETE
                modified:
                    PUT:
                        requestBody:
                            content:
                                modified:
                                    text/plain:
                                        schema:
                                            extensions:
                                                added:
                                                    - x-status
                                            items:
                                                uniqueItems:
                                                    from: false
                                                    to: true
endpoints:
    deleted:
        - method: DELETE
          path: /pets
    modified:
        ?   method: PUT
            path: /pets
        :   requestBody:
                content:
                    modified:
                        text/plain:
                            schema:
                                extensions:
                                    added:
                                        - x-status
                                items:
                                    uniqueItems:
                                        from: false
                                        to: true

