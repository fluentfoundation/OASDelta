openAPI:
    from: 3.0.3
    to: 3.1.0
paths:
    modified:
        /items/{id}.json:
            operations:
                modified:
                    DELETE:
                        responses:
                            modified:
                                default:
                                    headers:
                                        modified:
                                            ? "a\r\nb"
                                            :   schema:
                                                    maxProps:
                                                        from: 1
                                                        to: null
endpoints:
    modified:
        ?   method: DELETE
            path: /items/{id}.json
        :   responses:
                modified:
                    default:
                        headers:
                            modified:
                                ? "a\r\nb"
                                :   schema:
                                        maxProps:
                                            from: 1
                                            to: null

