paths:
    modified:
        /store/order:
            operations:
                modified:
                    PATCH:
                        responses:
                            modified:
                                "201":
                                    content:
                                        modified:
                                            application/json; charset=utf-8:
                                                schema:
                                                    items:
                                                        allOf:
                                                            deleted:
                                                                - index: 0
endpoints:
    modified:
        ?   method: PATCH
            path: /store/order
        :   responses:
                modified:
                    "201":
                        content:
                            modified:
                                application/json; charset=utf-8:
                                    schema:
                                        items:
                                            allOf:
                                                deleted:
                                                    - index: 0

