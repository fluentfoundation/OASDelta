                deleted:
                    - https://dev-testapi.azurewebsites.net
endpoints:
    modified:
        ?   method: POST
            path: /api/{uniqueId}/tests
        :   servers:
                added:
                    - https://qa-testapi.azurewebsites.net
                deleted:
                    - https://dev-testapi.azurewebsites.net
servers:
    added:
